<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Les recettes de Fahem ✨</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-creme: #FDFBF7;
      --card-bg: #FFFFFF;
      --accent-warm: #C86D51;
      --accent-light: #F7EBE6;
      --wood-dark: #2F231D;
      --wood-muted: #7D6B62;
      --tag-bg: #F4EFEA;
      --border-color: #EFE7DE;
      --radius-card: 20px;
      --shadow-cozy: 0 10px 25px -5px rgba(120, 80, 50, 0.08);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-creme);
      color: var(--wood-dark);
      font-family: 'DM Sans', sans-serif;
      line-height: 1.6;
      padding: 30px 16px 80px 16px;
    }

    .container { max-width: 850px; margin: 0 auto; }

    header { text-align: center; margin-bottom: 35px; }

    .badge-top {
      display: inline-block;
      background: var(--accent-light);
      color: var(--accent-warm);
      font-weight: 600;
      font-size: 0.85rem;
      padding: 6px 16px;
      border-radius: 99px;
      margin-bottom: 12px;
    }

    h1 {
      font-family: 'Fraunces', serif;
      font-size: 2.7rem;
      font-weight: 700;
      color: var(--wood-dark);
      margin-bottom: 8px;
    }

    p.subtitle {
      color: var(--wood-muted);
      font-size: 1.1rem;
      max-width: 500px;
      margin: 0 auto;
    }

    .toolbar {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 35px;
    }

    @media (min-width: 650px) {
      .toolbar {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .search-box input {
      width: 100%;
      padding: 12px 18px;
      border-radius: 12px;
      border: 1.5px solid var(--border-color);
      background: #FFFFFF;
      font-family: inherit;
      font-size: 0.95rem;
      color: var(--wood-dark);
      outline: none;
      transition: all 0.2s ease;
    }

    .search-box input:focus {
      border-color: var(--accent-warm);
      box-shadow: 0 0 0 3px rgba(200, 109, 81, 0.15);
    }

    .categories {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .cat-btn {
      background: #FFFFFF;
      border: 1.5px solid var(--border-color);
      color: var(--wood-muted);
      padding: 8px 16px;
      border-radius: 99px;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 500;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .cat-btn.active, .cat-btn:hover {
      background: var(--accent-warm);
      color: white;
      border-color: var(--accent-warm);
    }

    .recipes-list {
      display: flex;
      flex-direction: column;
      gap: 35px;
    }

    .recipe-card {
      background: var(--card-bg);
      border-radius: var(--radius-card);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-cozy);
      overflow: hidden;
      transition: transform 0.2s ease;
    }

    .recipe-card:hover {
      transform: translateY(-3px);
    }

    .recipe-image-wrap {
      width: 100%;
      height: 350px;
      overflow: hidden;
      background-color: var(--tag-bg);
    }

    .recipe-image-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      object-position: center;
    }

    .card-content {
      padding: 28px;
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
      gap: 15px;
    }

    .recipe-title {
      font-family: 'Fraunces', serif;
      font-size: 1.6rem;
      color: var(--wood-dark);
      font-weight: 600;
    }

    .tag {
      background: var(--tag-bg);
      color: var(--wood-muted);
      padding: 5px 12px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .recipe-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 18px;
      font-size: 0.9rem;
      color: var(--wood-muted);
      margin-bottom: 22px;
      padding-bottom: 16px;
      border-bottom: 1px dashed var(--border-color);
    }

    .portions-control {
      display: inline-flex;
      align-items: center;
      background: var(--bg-creme);
      padding: 3px 8px;
      border-radius: 99px;
      border: 1px solid var(--border-color);
      gap: 8px;
      margin-left: 6px;
    }

    .btn-portion {
      background: white;
      border: 1px solid var(--border-color);
      width: 22px;
      height: 22px;
      border-radius: 50%;
      cursor: pointer;
      font-weight: bold;
      color: var(--accent-warm);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .btn-portion:hover { background: var(--accent-light); }

    .recipe-body {
      display: grid;
      grid-template-columns: 1fr;
      gap: 25px;
    }

    @media (min-width: 680px) {
      .recipe-body { grid-template-columns: 1fr 1.3fr; }
    }

    .section-title {
      font-family: 'Fraunces', serif;
      font-size: 1.15rem;
      color: var(--accent-warm);
      margin-bottom: 12px;
    }

    ul.ingredient-list { list-style: none; }
    ul.ingredient-list li {
      padding: 6px 0;
      font-size: 0.95rem;
      border-bottom: 1px solid #FAF7F2;
      display: flex;
      gap: 8px;
    }
    ul.ingredient-list li::before { content: "•"; color: var(--accent-warm); }

    ol.steps-list { padding-left: 20px; }
    ol.steps-list li {
      margin-bottom: 12px;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>

  <div class="container">
    <header>
      <span class="badge-top">☕ Carnet Privé</span>
      <h1>Les recettes de Fahem ✨</h1>
      <p class="subtitle">Petits plats réconfortants, cuisinés avec patience et amour.</p>
    </header>

    <div class="toolbar">
      <div class="search-box">
        <input type="text" id="searchInput" placeholder="Chercher un plat, un ingrédient..." oninput="filtrerRecettes()" />
      </div>
      <div class="categories">
        <button class="cat-btn active" onclick="setCategory('tous', this)">Tous</button>
        <button class="cat-btn" onclick="setCategory('Plats', this)">Plats</button>
        <button class="cat-btn" onclick="setCategory('Desserts', this)">Desserts</button>
        <button class="cat-btn" onclick="setCategory('Boissons', this)">Boissons</button>
      </div>
    </div>

    <main class="recipes-list" id="recipesContainer"></main>
  </div>

  <script>
    const recettes = [
      {
        id: 1,
        titre: "Curry Japonais (Roux Maison)",
        image: "image_bcf07b.jpg", 
        categorie: "Plats",
        tempsPrepa: "20 min",
        tempsCuisson: "30 min",
        portionsBase: 4,
        portionsActuelles: 4,
        ingredients: [
          { qte: 500, unite: "g", nom: "escalopes de poulet" },
          { qte: 1, unite: "c. à soupe", nom: "oignon en poudre" },
          { qte: 1, unite: "c. à café", nom: "ail en poudre" },
          { qte: 1, unite: "pincée", nom: "gingembre râpé" },
          { qte: 2, unite: "", nom: "gousses d'ail pressées" },
          { qte: 2, unite: "c. à soupe", nom: "sauce soja" },
          { qte: 2, unite: "", nom: "oignons rouges" },
          { qte: 1, unite: "c. à soupe", nom: "concentré de tomate" },
          { qte: 1, unite: "L", nom: "bouillon de légumes" },
          { qte: 1, unite: "", nom: "grosse carotte" },
          { qte: 1, unite: "", nom: "grosse pomme de terre" },
          { qte: 0.25, unite: "", nom: "pomme rouge bio (râpée)" },
          { qte: 1, unite: "filet", nom: "miel" },
          { qte: 50, unite: "g", nom: "farine" },
          { qte: 50, unite: "g", nom: "beurre (fondu)" },
          { qte: 2, unite: "c. à soupe", nom: "garam masala" },
          { qte: 1, unite: "c. à soupe", nom: "curcuma" },
          { qte: 1, unite: "c. à café", nom: "piment d'Espelette" },
          { qte: 1, unite: "c. à café", nom: "coriandre moulue" },
          { qte: 1, unite: "carreau", nom: "chocolat noir" },
          { qte: 1, unite: "portion", nom: "riz basmati (pour servir)" }
        ],
        etapes: [
          "Préparer la marinade : mélanger les escalopes avec l'oignon en poudre, l'ail en poudre, le gingembre râpé, l'ail pressé et la sauce soja.",
          "Dans une marmite, laisser caraméliser les oignons rouges. Ajouter une cuillère à soupe de concentré de tomate, puis verser le litre de bouillon de légumes.",
          "Couper la carotte et la pomme de terre en gros morceaux. Râper le quart de pomme rouge bio. Ajouter le tout dans la marmite avec un filet de miel.",
          "Faire le roux : dans une casserole, ajouter la farine au beurre fondu. Quand ça commence à former une pâte qui se colle bien en un morceau en remuant, ajouter les épices (garam masala, curcuma, piment d'Espelette, coriandre moulue). Laisser sur le feu en remuant régulièrement jusqu'à ce que les épices soient bien incorporées (on peut ajouter un peu de concentré de tomate).",
          "Délayer ce roux au préalable avec une petite louche de bouillon, puis l'incorporer petit à petit dans la marmite en fouettant bien.",
          "Faire revenir la viande marinée séparément à feu fort pour caraméliser le fond de la poêle. Quand elle est bien dorée, ajouter un peu d'eau pour déglacer et transvaser le tout dans la grosse marmite.",
          "Laisser mijoter à feu doux pendant au moins 30 minutes pour cuire le poulet et laisser épaissir le tout.",
          "Ajouter 1 carreau de chocolat noir pour la touche finale. Servir bien chaud sur du riz basmati."
        ]
      }
    ];

    let categorieActive = 'tous';

    function modifierPortions(id, delta) {
      const rec = recettes.find(r => r.id === id);
      if (rec && rec.portionsActuelles + delta >= 1) {
        rec.portionsActuelles += delta;
        renderRecettes();
      }
    }

    function setCategory(cat, btn) {
      categorieActive = cat;
      document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderRecettes();
    }

    function filtrerRecettes() {
      renderRecettes();
    }

    function renderRecettes() {
      const container = document.getElementById('recipesContainer');
      const search = document.getElementById('searchInput').value.toLowerCase();

      const filtrees = recettes.filter(r => {
        const matchCat = (categorieActive === 'tous') || (r.categorie === categorieActive);
        const matchSearch = r.titre.toLowerCase().includes(search) ||
                            r.ingredients.some(i => i.nom.toLowerCase().includes(search));
        return matchCat && matchSearch;
      });

      if (filtrees.length === 0) {
        container.innerHTML = `<p style="text-align:center; color:var(--wood-muted); margin-top:40px;">Aucune recette trouvée... 🍂</p>`;
        return;
      }

      container.innerHTML = filtrees.map(r => {
        const ratio = r.portionsActuelles / r.portionsBase;

        const htmlIngredients = r.ingredients.map(ing => {
          let quantiteAffichee = "";
          if (ing.qte) {
            const calculee = Math.round(ing.qte * ratio * 10) / 10;
            quantiteAffichee = `<strong>${calculee} ${ing.unite}</strong> `;
          }
          return `<li>${quantiteAffichee}${ing.nom}</li>`;
        }).join('');

        const htmlEtapes = r.etapes.map(e => `<li>${e}</li>`).join('');

        const imageBlock = r.image ? `
          <div class="recipe-image-wrap">
            <img src="${r.image}" alt="${r.titre}" onerror="this.parentElement.style.display='none'"/>
          </div>
        ` : '';

        return `
          <article class="recipe-card">
            ${imageBlock}
            <div class="card-content">
              <div class="card-header">
                <h2 class="recipe-title">${r.titre}</h2>
                <span class="tag">${r.categorie}</span>
              </div>

              <div class="recipe-meta">
                <span>⏱️ Prépa : ${r.tempsPrepa}</span>
                <span>🔥 Cuisson : ${r.tempsCuisson}</span>
                <span>
                  👥 Portions : 
                  <div class="portions-control">
                    <button class="btn-portion" onclick="modifierPortions(${r.id}, -1)">-</button>
                    <strong style="min-width: 14px; text-align:center;">${r.portionsActuelles}</strong>
                    <button class="btn-portion" onclick="modifierPortions(${r.id}, 1)">+</button>
                  </div>
                </span>
              </div>

              <div class="recipe-body">
                <div>
                  <h3 class="section-title">🌾 Ingrédients</h3>
                  <ul class="ingredient-list">${htmlIngredients}</ul>
                </div>
                <div>
                  <h3 class="section-title">✨ Préparation</h3>
                  <ol class="steps-list">${htmlEtapes}</ol>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join('');
    }

    renderRecettes();
  </script>
</body>
</html>